&CONTROL
! Chapter 11: SCF at the saddle point found by CI-NEB, then ph.x at Gamma
! displacing only H (h_ts.ph_gamma.in, nat_todo = 1) as a quick check that
! exactly one imaginary mode exists. The H position below is only the
! bridge-site guess: replace ALL coordinates by those of the climbing image
! (from h_al100_neb.xyz or h_al100_neb.crd after convergence).
! Same pseudopotentials and settings as the NEB run.
  calculation   = 'scf'
  prefix        = 'h_ts'
  outdir        = './tmp'
  pseudo_dir    = './pseudo'
/
&SYSTEM
  ibrav       = 0
  nat         = 13
  ntyp        = 2
  ecutwfc     = 60.0          ! max SSSP hint of Al (30) and H (60)
  ecutrho     = 480.0
  occupations = 'smearing'
  smearing    = 'mv'
  degauss     = 0.02
/
&ELECTRONS
  conv_thr    = 1.0d-12        ! tight SCF before ph.x
  mixing_beta = 0.3
/
ATOMIC_SPECIES
  Al  26.9815  Al.pbe-n-kjpaw_psl.1.0.0.UPF
  H    1.008   H.pbe-rrkjus_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
  5.71342  0.00000   0.00000
  0.00000  5.71342   0.00000
  0.00000  0.00000  20.00000
ATOMIC_POSITIONS angstrom
  Al  0.00000  0.00000  2.00000   0 0 0
  Al  0.00000  2.85671  2.00000   0 0 0
  Al  2.85671  0.00000  2.00000   0 0 0
  Al  2.85671  2.85671  2.00000   0 0 0
  Al  1.42836  1.42836  4.02000
  Al  1.42836  4.28507  4.02000
  Al  4.28507  1.42836  4.02000
  Al  4.28507  4.28507  4.02000
  Al  0.00000  0.00000  6.04000
  Al  0.00000  2.85671  6.04000
  Al  2.85671  0.00000  6.04000
  Al  2.85671  2.85671  6.04000
  H   2.85671  1.42836  6.80000
K_POINTS automatic
  6 6 1 0 0 0
