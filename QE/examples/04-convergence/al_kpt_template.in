&CONTROL
! fcc Al template for the k-point x smearing convergence scan.
! Placeholders replaced by run_conv.sh:
!   @K@        -> k-point grid "N N N"
!   @DEGAUSS@  -> smearing width in Ry
!   @SMEAR@    -> smearing type (e.g. mv, mp, gaussian, fd)
! ecutwfc/ecutrho should be the values you converged first (here: SSSP hint
! 30/240 Ry plus a safety margin).
! Pseudopotential: SSSP 1.3 PBE efficiency, Al.pbe-n-kjpaw_psl.1.0.0.UPF (PAW).
  calculation = 'scf'
  prefix      = 'al'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
  tprnfor     = .true.
  tstress     = .true.
/
&SYSTEM
  ibrav     = 2
  celldm(1) = 7.65         ! a in Bohr (about 4.05 Angstrom)
  nat       = 1
  ntyp      = 1
  ecutwfc   = 40.0
  ecutrho   = 320.0
  occupations = 'smearing' ! Al is a metal: smearing is mandatory
  smearing    = '@SMEAR@'
  degauss     = @DEGAUSS@
/
&ELECTRONS
  conv_thr    = 1.0d-10
  mixing_beta = 0.7
/
ATOMIC_SPECIES
  Al  26.9815  Al.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Al  0.00  0.00  0.00
K_POINTS automatic
  @K@ 0 0 0
