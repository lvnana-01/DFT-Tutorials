&CONTROL
! Chapter 12: fcc Al (metal) for DFPT. Metals need occupations='smearing'
! already in the scf; phonons converge slowly with k points and degauss.
! Pseudopotential (SSSP 1.3 PBE efficiency): Al.pbe-n-kjpaw_psl.1.0.0.UPF
  calculation = 'scf'
  prefix      = 'al'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
/
&SYSTEM
  ibrav       = 2
  celldm(1)   = 7.65         ! Bohr, replace by your relaxed value
  nat         = 1
  ntyp        = 1
  ecutwfc     = 30.0
  ecutrho     = 240.0
  occupations = 'smearing'
  smearing    = 'mv'
  degauss     = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-12
/
ATOMIC_SPECIES
  Al  26.9815  Al.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Al  0.00  0.00  0.00
K_POINTS automatic
  16 16 16 0 0 0
