&CONTROL
! Chapter 12: ground state of bulk Si for DFPT (ph.x).
! Pseudopotential (SSSP 1.3 PBE efficiency, put in ./pseudo):
!   Si.pbe-n-rrkjus_psl.1.0.0.UPF  (hint 30 / 240 Ry)
! Use the lattice parameter from YOUR relaxation (Chapter 5); ph.x cannot
! start from a vc-relax run directly, so always run this scf afterwards.
  calculation = 'scf'
  prefix      = 'si'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
/
&SYSTEM
  ibrav     = 2              ! keep the Bravais lattice index: symmetry matters for ph.x
  celldm(1) = 10.26          ! Bohr
  nat       = 2
  ntyp      = 1
  ecutwfc   = 30.0
  ecutrho   = 240.0
/
&ELECTRONS
  conv_thr = 1.0d-12         ! DFPT needs a very well converged ground state
/
ATOMIC_SPECIES
  Si  28.0855  Si.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Si  0.00  0.00  0.00
  Si  0.25  0.25  0.25
K_POINTS automatic
  8 8 8 0 0 0
