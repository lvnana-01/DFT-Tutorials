&CONTROL
! Smoke test for a fresh Quantum ESPRESSO installation (pw.x >= 7.0).
! Diamond Si, PBE, SCF only. Should finish in seconds on a laptop.
! Pseudopotential: SSSP 1.3 PBE efficiency -> Si.pbe-n-rrkjus_psl.1.0.0.UPF
! (ultrasoft; SSSP recommended cutoffs 30 Ry / 240 Ry). Put it in ./pseudo/
! Run:  mpirun -np 2 pw.x -i si_test.in > si_test.out
  calculation = 'scf'
  prefix      = 'si_test'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
  tprnfor     = .true.
  tstress     = .true.
/
&SYSTEM
  ibrav     = 2           ! fcc Bravais lattice
  celldm(1) = 10.26       ! lattice parameter a in Bohr (about 5.43 Angstrom)
  nat       = 2
  ntyp      = 1
  ecutwfc   = 30.0        ! Ry
  ecutrho   = 240.0       ! Ry, dual = 8 for an ultrasoft pseudopotential
/
&ELECTRONS
  conv_thr    = 1.0d-8
  mixing_beta = 0.7
/
ATOMIC_SPECIES
  Si  28.0855  Si.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Si  0.00  0.00  0.00
  Si  0.25  0.25  0.25
K_POINTS automatic
  4 4 4 0 0 0
