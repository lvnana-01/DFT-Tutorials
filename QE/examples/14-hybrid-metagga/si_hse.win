! si_hse.win -- Wannier interpolation of HSE bands of Si (8 WFs: sp3 on each Si)
num_wann        = 8
num_bands       = 12
num_iter        = 200

dis_win_max     = 17.0     ! eV, outer window (absolute energies of the pw.x run)
dis_froz_max    = 6.5      ! eV, frozen window: put it ~1 eV above the VBM of YOUR run
dis_num_iter    = 200

bands_plot      = .true.
bands_num_points = 100
write_hr        = .true.
write_xyz       = .true.

begin projections
Si:sp3
end projections

begin unit_cell_cart
ang
 -2.7150   0.0000   2.7150
  0.0000   2.7150   2.7150
 -2.7150   2.7150   0.0000
end unit_cell_cart

begin atoms_frac
Si  0.00  0.00  0.00
Si  0.25  0.25  0.25
end atoms_frac

! path in fractional coordinates of the reciprocal vectors of the cell above
begin kpoint_path
L  0.000  0.500  0.000   G  0.000  0.000  0.000
G  0.000  0.000  0.000   X  0.000  0.500  0.500
X  0.000  0.500  0.500   U  0.000  0.625  0.375
K -0.375  0.375  0.000   G  0.000  0.000  0.000
end kpoint_path

mp_grid = 4 4 4

