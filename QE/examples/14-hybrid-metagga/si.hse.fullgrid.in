! Si HSE SCF on an EXPLICIT full 4x4x4 grid (K_POINTS crystal, equal weights),
! generated like Wannier90's utility/kmesh.pl 4 4 4. This run is the starting point
! for Wannier interpolation of the HSE bands (pw2wannier90.x reads these wavefunctions).
! With an explicit k list there is no default EXX q mesh: nqx1..3 MUST be given.
&CONTROL
  calculation = 'scf'
  prefix      = 'si_hse_w'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
  verbosity   = 'high'     ! print eigenvalues at all 64 k points
/
&SYSTEM
  ibrav     = 0
  nat       = 2
  ntyp      = 1
  ecutwfc   = 40.0
  ecutrho   = 160.0
  nbnd      = 12          ! 4 occupied + 8 empty: enough for 8 Wannier functions (sp3 on both Si)
  input_dft = 'hse'
  nqx1 = 2, nqx2 = 2, nqx3 = 2
  nosym     = .true.      ! keep the k list exactly as given (same order as the .nnkp file)
  noinv     = .true.
/
&ELECTRONS
  conv_thr        = 1.0d-10
  diago_full_acc  = .true.
/
ATOMIC_SPECIES
  Si  28.0855  Si_ONCV_PBE-1.2.upf
CELL_PARAMETERS angstrom
  -2.7150   0.0000   2.7150
   0.0000   2.7150   2.7150
  -2.7150   2.7150   0.0000
ATOMIC_POSITIONS crystal
  Si  0.00  0.00  0.00
  Si  0.25  0.25  0.25
K_POINTS crystal
64
