&CONTROL
! Bulk AB (Bernal) graphite: variable-cell relaxation with a dispersion
! correction. Change vdw_corr / input_dft to compare methods (run_vdw_compare.sh
! replaces the line marked @VDW@).
! Pseudopotential: SSSP 1.3 PBE efficiency, C.pbe-n-kjpaw_psl.1.0.0.UPF (45 / 360 Ry)
  calculation   = 'vc-relax'
  prefix        = 'graphite'
  outdir        = './tmp'
  pseudo_dir    = './pseudo'
  tprnfor       = .true.
  tstress       = .true.
  forc_conv_thr = 1.0d-4
  etot_conv_thr = 1.0d-6
/
&SYSTEM
  ibrav       = 4                ! hexagonal
  A           = 2.464            ! in-plane lattice constant (Angstrom)
  C           = 6.80             ! start slightly above the exp. 6.71 Angstrom
  nat         = 4
  ntyp        = 1
  ecutwfc     = 50.0
  ecutrho     = 400.0
  occupations = 'smearing'
  smearing    = 'mv'
  degauss     = 0.01
  vdw_corr    = 'grimme-d3'      ! @VDW@
  dftd3_version = 4              ! D3(BJ); ignored by other methods
/
&ELECTRONS
  conv_thr    = 1.0d-10
  mixing_beta = 0.5
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press_conv_thr = 0.5
/
ATOMIC_SPECIES
  C  12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  C  0.000000  0.000000  0.250000
  C  0.000000  0.000000  0.750000
  C  0.333333  0.666667  0.250000
  C  0.666667  0.333333  0.750000
K_POINTS automatic
  12 12 4 0 0 0
