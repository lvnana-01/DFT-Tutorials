&CONTROL
! Monolayer 2H-MoS2: relax the in-plane lattice constant only
! (cell_dofree = '2Dxy'); the vacuum along z stays fixed.
! Pseudopotentials (SSSP 1.3 PBE efficiency):
!   Mo_ONCV_PBE-1.0.oncvpsp.upf  (35 / 140 Ry)
!   s_pbe_v1.4.uspp.F.UPF        (35 / 280 Ry)
  calculation   = 'vc-relax'
  prefix        = 'mos2'
  outdir        = './tmp'
  pseudo_dir    = './pseudo'
  tprnfor       = .true.
  tstress       = .true.
  forc_conv_thr = 1.0d-4
/
&SYSTEM
  ibrav       = 4
  A           = 3.19             ! in-plane lattice constant (Angstrom)
  C           = 20.0             ! about 17 Angstrom of vacuum
  nat         = 3
  ntyp        = 2
  ecutwfc     = 45.0
  ecutrho     = 360.0
  occupations = 'fixed'
  vdw_corr    = 'grimme-d3'
  dftd3_version = 4
/
&ELECTRONS
  conv_thr    = 1.0d-10
  mixing_beta = 0.5
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  cell_dofree   = '2Dxy'         ! only x and y components of the cell move
  press_conv_thr = 0.5
/
ATOMIC_SPECIES
  Mo  95.95   Mo_ONCV_PBE-1.0.oncvpsp.upf
  S   32.06   s_pbe_v1.4.uspp.F.UPF
! Mo at z = 10 Angstrom, S at +/- 1.56 Angstrom
ATOMIC_POSITIONS angstrom
  Mo  0.000000  0.000000  10.000000
  S   1.595000  0.920873  11.560000
  S   1.595000  0.920873   8.440000
K_POINTS automatic
  12 12 1 0 0 0
