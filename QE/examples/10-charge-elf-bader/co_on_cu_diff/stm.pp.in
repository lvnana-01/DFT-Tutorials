&INPUTPP
! Tersoff-Hamann STM image (plot_num = 5) of CO/Cu(111).
! sample_bias is in Ry: states between E_F and E_F + sample_bias are summed.
! -0.0735 Ry is about -1.0 eV (occupied states of the sample).
! The slab normal must be along the third lattice vector.
  prefix      = 'ab'
  outdir      = './tmp'
  filplot     = 'ab.stm.pp'
  plot_num    = 5
  sample_bias = -0.0735
/
&PLOT
  nfile = 1, filepp(1) = 'ab.stm.pp'
  iflag = 3, output_format = 6, fileout = 'ab_stm.cube'
/
