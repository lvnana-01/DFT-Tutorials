&CONTROL
! Chapter 10: SCF of bulk Si; the charge density is then exported with pp.x.
! Pseudopotential (SSSP 1.3 PBE efficiency): Si.pbe-n-rrkjus_psl.1.0.0.UPF
! (hint 30 / 240 Ry). Put it in ./pseudo (not committed to the repository).
  calculation = 'scf'
  prefix      = 'si'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
/
&SYSTEM
  ibrav     = 2
  celldm(1) = 10.26          ! lattice parameter in Bohr (use your relaxed value)
  nat       = 2
  ntyp      = 1
  ecutwfc   = 30.0
  ecutrho   = 240.0
/
&ELECTRONS
  conv_thr = 1.0d-10
/
ATOMIC_SPECIES
  Si  28.0855  Si.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Si  0.00  0.00  0.00
  Si  0.25  0.25  0.25
K_POINTS automatic
  8 8 8 0 0 0
