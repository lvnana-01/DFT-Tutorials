&CONTROL
! NiO AFM-II with DFT+U (Dudarev, ortho-atomic projectors), QE >= 7.1 syntax.
! The U value below is a DEMONSTRATION value only. Replace it with the
! value you obtain from hp.x (run_hp.sh) for THIS pseudopotential and
! THIS projector type; U values are not transferable between setups.
! Pseudopotentials (SSSP 1.3 PBE efficiency):
!   ni_pbe_v1.4.uspp.F.UPF      (45 / 360 Ry)
!   O.pbe-n-kjpaw_psl.0.1.UPF   (50 / 400 Ry)
  calculation = 'scf'
  prefix      = 'nio_u'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
  tprnfor     = .true.
  tstress     = .true.
/
&SYSTEM
  ibrav       = 0
  nat         = 4
  ntyp        = 3
  ecutwfc     = 50.0
  ecutrho     = 400.0
  occupations = 'smearing'
  smearing    = 'gaussian'
  degauss     = 0.005
  nspin       = 2
  starting_magnetization(1) =  0.5
  starting_magnetization(2) = -0.5
  nbnd        = 30
/
&ELECTRONS
  conv_thr    = 1.0d-9
  mixing_beta = 0.3
/
ATOMIC_SPECIES
  Ni1  58.6934  ni_pbe_v1.4.uspp.F.UPF
  Ni2  58.6934  ni_pbe_v1.4.uspp.F.UPF
  O    15.999   O.pbe-n-kjpaw_psl.0.1.UPF
CELL_PARAMETERS angstrom
  4.170  2.085  2.085
  2.085  4.170  2.085
  2.085  2.085  4.170
! Hubbard atoms must come first (required by hp.x, harmless for pw.x)
ATOMIC_POSITIONS angstrom
  Ni1  0.000  0.000  0.000
  Ni2  2.085  2.085  0.000
  O    2.085  0.000  0.000
  O    4.170  2.085  0.000
K_POINTS automatic
  6 6 6 0 0 0
! Labels must match ATOMIC_SPECIES (Ni1, Ni2); manifold 3d must exist in the UPF
HUBBARD {ortho-atomic}
U Ni1-3d 6.0
U Ni2-3d 6.0
