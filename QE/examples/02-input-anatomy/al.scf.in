&CONTROL
! fcc Al: a simple metal, so smearing is required.
! Pseudopotential: SSSP 1.3 PBE efficiency, Al.pbe-n-kjpaw_psl.1.0.0.UPF
! (PAW, SSSP hint 30 / 240 Ry). Place it in ./pseudo/
! Run: mpirun -np 4 pw.x -nk 4 -i al.scf.in > al.scf.out
  calculation = 'scf'
  prefix      = 'al'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
  tprnfor     = .true.
  tstress     = .true.
/
&SYSTEM
  ibrav     = 2
  celldm(1) = 7.65            ! Bohr (about 4.05 Angstrom)
  nat       = 1
  ntyp      = 1
  ecutwfc   = 30.0
  ecutrho   = 240.0
  occupations = 'smearing'    ! mandatory for metals
  smearing    = 'mv'          ! Marzari-Vanderbilt cold smearing
  degauss     = 0.02          ! Ry; test together with the k-point grid
/
&ELECTRONS
  conv_thr    = 1.0d-10
  mixing_beta = 0.7
/
ATOMIC_SPECIES
  Al  26.9815  Al.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Al  0.00  0.00  0.00
K_POINTS automatic
  12 12 12 0 0 0
