&CONTROL
! Isolated H2O molecule in a 12 Angstrom cubic box, Gamma point only,
! Martyna-Tuckerman correction for the periodic images.
! Pseudopotentials: SSSP 1.3 PBE efficiency
!   O.pbe-n-kjpaw_psl.0.1.UPF   (PAW, hint 50 / 400 Ry)
!   H.pbe-rrkjus_psl.1.0.0.UPF  (US,  hint 60 / 480 Ry)
! Cutoffs = maximum over all elements -> 60 / 480 Ry.
! Geometry: approximate gas-phase water (O-H about 0.96 A, H-O-H about 104.5 deg),
! molecule placed at the box centre. Test the box size before production runs.
  calculation = 'scf'
  prefix      = 'h2o'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
  tprnfor     = .true.
/
&SYSTEM
  ibrav   = 1                 ! simple cubic
  A       = 12.0              ! box edge in ANGSTROM
  nat     = 3
  ntyp    = 2
  ecutwfc = 60.0
  ecutrho = 480.0
  nbnd    = 8                 ! 4 occupied + 4 empty -> HOMO and LUMO printed
  assume_isolated = 'mt'      ! Martyna-Tuckerman
/
&ELECTRONS
  conv_thr = 1.0d-9
/
ATOMIC_SPECIES
  O  15.999  O.pbe-n-kjpaw_psl.0.1.UPF
  H   1.008  H.pbe-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS angstrom
  O   6.000000   6.000000   6.000000
  H   6.757000   6.586000   6.000000
  H   5.243000   6.586000   6.000000
K_POINTS gamma
