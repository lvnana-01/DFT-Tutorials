&CONTROL
! First SCF calculation: diamond Si with the built-in fcc lattice (ibrav = 2).
! Pseudopotential: SSSP 1.3 PBE efficiency, Si.pbe-n-rrkjus_psl.1.0.0.UPF
! (ultrasoft, SSSP hint 30 / 240 Ry). Place it in ./pseudo/
! Run: mpirun -np 4 pw.x -nk 2 -i si.scf.in > si.scf.out
  calculation = 'scf'
  prefix      = 'si'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
  tprnfor     = .true.        ! print forces
  tstress     = .true.        ! print stress tensor
/
&SYSTEM
  ibrav     = 2               ! fcc Bravais lattice
  celldm(1) = 10.26           ! lattice parameter a in BOHR (about 5.43 Angstrom)
  nat       = 2
  ntyp      = 1
  ecutwfc   = 30.0            ! Ry
  ecutrho   = 240.0           ! Ry (dual = 8 for ultrasoft)
  ! occupations not set -> fixed occupations (insulator)
  ! nbnd = 8                  ! uncomment to also get the LUMO
/
&ELECTRONS
  conv_thr    = 1.0d-10       ! Ry, extensive quantity
  mixing_beta = 0.7
/
ATOMIC_SPECIES
  Si  28.0855  Si.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Si  0.00  0.00  0.00
  Si  0.25  0.25  0.25
K_POINTS automatic
  8 8 8 0 0 0
