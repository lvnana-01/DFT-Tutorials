&CONTROL
! bcc Fe, noncollinear scf WITHOUT spin-orbit: the magnetization starts
! in the x direction (angle1 = 90, angle2 = 0). Without SOC the total
! energy must not depend on the direction (useful sanity check).
! Pseudopotential: Fe.pbe-spn-kjpaw_psl.0.2.1.UPF (SSSP 1.3 efficiency)
  calculation = 'scf'
  prefix      = 'fe_nc'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
/
&SYSTEM
  ibrav       = 3
  celldm(1)   = 5.42
  nat         = 1
  ntyp        = 1
  ecutwfc     = 90.0
  ecutrho     = 1080.0
  occupations = 'smearing'
  smearing    = 'mv'
  degauss     = 0.02
  noncolin    = .true.
  starting_magnetization(1) = 0.5
  angle1(1)   = 90.0
  angle2(1)   = 0.0
  report      = 1                ! print local moments every scf iteration
/
&ELECTRONS
  conv_thr    = 1.0d-9
  mixing_beta = 0.2
/
ATOMIC_SPECIES
  Fe  55.845  Fe.pbe-spn-kjpaw_psl.0.2.1.UPF
ATOMIC_POSITIONS crystal
  Fe  0.0  0.0  0.0
K_POINTS automatic
  14 14 14 0 0 0
