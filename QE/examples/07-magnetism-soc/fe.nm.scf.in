&CONTROL
! bcc Fe, non-magnetic reference (nspin = 1). Compare the total energy
! with fe.scf.in to obtain the magnetic stabilization energy.
  calculation = 'scf'
  prefix      = 'fe_nm'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
/
&SYSTEM
  ibrav       = 3
  celldm(1)   = 5.42
  nat         = 1
  ntyp        = 1
  ecutwfc     = 90.0
  ecutrho     = 1080.0
  occupations = 'smearing'
  smearing    = 'mv'
  degauss     = 0.02
/
&ELECTRONS
  conv_thr    = 1.0d-9
  mixing_beta = 0.3
/
ATOMIC_SPECIES
  Fe  55.845  Fe.pbe-spn-kjpaw_psl.0.2.1.UPF
ATOMIC_POSITIONS crystal
  Fe  0.0  0.0  0.0
K_POINTS automatic
  14 14 14 0 0 0
