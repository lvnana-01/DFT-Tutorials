&CONTROL
! Step 1: self-consistent ground state of diamond Si.
! The charge density saved in ./tmp/si.save is reused by the bands and
! nscf steps, so prefix/outdir/pseudo/cutoffs must stay identical.
! Pseudopotential: SSSP 1.3 PBE efficiency, Si.pbe-n-rrkjus_psl.1.0.0.UPF
  calculation = 'scf'
  prefix      = 'si'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
/
&SYSTEM
  ibrav     = 2
  celldm(1) = 10.26           ! replace by your relaxed value (Chapter 5)
  nat       = 2
  ntyp      = 1
  ecutwfc   = 40.0
  ecutrho   = 320.0
  occupations = 'fixed'
  nbnd      = 8               ! 4 occupied + 4 empty: also prints the LUMO
/
&ELECTRONS
  conv_thr    = 1.0d-10
  mixing_beta = 0.7
/
ATOMIC_SPECIES
  Si  28.0855  Si.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Si  0.00  0.00  0.00
  Si  0.25  0.25  0.25
K_POINTS automatic
  8 8 8 0 0 0
