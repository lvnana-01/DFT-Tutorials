! Born-Oppenheimer MD of crystalline Si (64-atom 2x2x2 cubic supercell) with pw.x.
! NVE production run: velocities are initialised once at tempw and then left
! uncontrolled (ion_temperature = 'initial'). Use it to check energy conservation
! ("Ekin + Etot (const)"). For a continuation of an equilibrated NVT run,
! start from the final positions/velocities instead (see README.md).
! Pseudopotential: SSSP 1.3 PBE efficiency, Si.pbe-n-rrkjus_psl.1.0.0.UPF (ultrasoft).
! Time unit: dt is in Rydberg atomic units, 1 Ry a.u. = 4.8378e-17 s,
! so dt = 40 corresponds to about 1.94 fs.
&CONTROL
  calculation = 'md'
  prefix      = 'si64nve'
  outdir      = './tmp'
  pseudo_dir  = './pseudo'
  dt          = 40.0          ! Ry a.u. (~1.94 fs)
  nstep       = 500           ! ~1 ps
  iprint      = 1
  tprnfor     = .true.
  max_seconds = 82800         ! stop cleanly before a 24 h wall-time limit
  disk_io     = 'low'
/
&SYSTEM
  ibrav       = 1
  celldm(1)   = 20.52         ! Bohr = 2 x 10.26 (2x2x2 conventional cells); use your relaxed a
  nat         = 64
  ntyp        = 1
  ecutwfc     = 30.0
  ecutrho     = 240.0
  occupations = 'smearing'    ! safe if the system becomes metallic (hot/liquid Si)
  smearing    = 'gaussian'
  degauss     = 0.01
/
&ELECTRONS
  conv_thr    = 1.0d-10       ! tighter for NVE energy conservation
  mixing_beta = 0.5
/
&IONS
  ion_dynamics      = 'verlet'
  ion_temperature   = 'initial'      ! random velocities at tempw, then NVE
  tempw             = 1000.0         ! K
  pot_extrapolation = 'second_order'
  wfc_extrapolation = 'second_order'
/
ATOMIC_SPECIES
  Si  28.0855  Si.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Si  0.000000  0.000000  0.000000
  Si  0.000000  0.250000  0.250000
  Si  0.250000  0.000000  0.250000
  Si  0.250000  0.250000  0.000000
  Si  0.125000  0.125000  0.125000
  Si  0.125000  0.375000  0.375000
  Si  0.375000  0.125000  0.375000
  Si  0.375000  0.375000  0.125000
