! cp.x step 2: Car-Parrinello dynamics (NVE), restarting from step 1.
! Reads outdir/h2o_50.save (ndr = 50) and writes outdir/h2o_51.save (ndw = 51).
! electron_velocities = 'zero' and ion_velocities = 'zero' are needed ONLY for
! this first CP run after a damped minimisation; remove them when restarting
! from h2o_51.save, otherwise the dynamics is quenched at every restart.
&CONTROL
  calculation  = 'cp'
  title        = 'H2O molecule, CP dynamics'
  restart_mode = 'restart'
  prefix       = 'h2o'
  outdir       = './tmp'
  pseudo_dir   = './pseudo'
  ndr          = 50
  ndw          = 51
  nstep        = 2000           ! 2000 x 5 a.u. = 0.24 ps
  iprint       = 10             ! trajectory files every 10 steps
  isave        = 500
  dt           = 5.0
  tprnfor      = .true.
/
&SYSTEM
  ibrav     = 1
  celldm(1) = 20.0
  nat       = 3
  ntyp      = 2
  ecutwfc   = 85.0
/
&ELECTRONS
  electron_dynamics   = 'verlet'
  electron_velocities = 'zero'  ! first CP run only
  emass               = 400.0
  emass_cutoff        = 2.5
/
&IONS
  ion_dynamics   = 'verlet'
  ion_velocities = 'zero'       ! first CP run only; the stretched O-H bond starts the motion
/
ATOMIC_SPECIES
  O  15.999  O.upf
  H   2.014  H.upf
ATOMIC_POSITIONS angstrom
  O   5.290  5.290  5.410
  H   5.290  6.090  4.790
  H   5.290  4.530  4.820
