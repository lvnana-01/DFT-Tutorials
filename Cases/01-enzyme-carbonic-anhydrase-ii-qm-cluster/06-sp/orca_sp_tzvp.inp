# Single point on the def2-SVP geometry: B3LYP-D3(BJ)/def2-TZVP, CPCM eps = 4.
# Run once per stationary point (reactant, TS, product); change the xyz name.
# Use charge 0 instead of 1 for the --with-glu106 models.
! B3LYP D3BJ def2-TZVP def2/J RIJCOSX CPCM(water) TightSCF

%pal nprocs 16 end
%maxcore 4000

%cpcm
  epsilon 4.0
end

* xyzfile 1 1 orca_opt_reactant.xyz
